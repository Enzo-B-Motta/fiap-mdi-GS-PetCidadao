{
  "expo": {
    "name": "Importa",
    "slug": "importa-mobile",
    "scheme": "importa",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#FFE500" },
    "ios": { "bundleIdentifier": "br.com.importa.mobile" },
    "android": { "package": "br.com.importa.mobile" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-status-bar", "expo-image", "expo-secure-store",
      ["expo-image-picker", { "cameraPermission": "O Pet Cidadão usa a câmera para fotografar animais." }],
      ["expo-location", { "locationWhenInUsePermission": "O Pet Cidadão usa sua localização para registrar onde o animal foi visto." }]
    ]
  }
}
